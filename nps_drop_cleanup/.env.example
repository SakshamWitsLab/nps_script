# =============================================================================
# NPS Drop Cleanup - .env configuration reference
# Copy this file to ".env" (same directory) and fill in the values you need.
# Any variable can also be exported in your shell instead.
# =============================================================================

# ---------------------------------------------------------------------------
# Database connection
#
# Build the connection from the PG_* parts below, OR set a single DATABASE_URL
# (DATABASE_URL wins when both are present). DB_HOST/DB_PORT/DB_NAME/DB_USER/
# DB_PASSWORD are accepted as older aliases of PG_HOST/PG_PORT/PG_DATABASE/
# PG_USER/PG_PASSWORD.
#
# Current local Docker setup (port 5433):
#   nps_chatbot       = pristine reference, used as the baseline
#   nps_chatbot_hard  = target for a hard-delete run (DELETE_MODE=hard)
#   nps_chatbot_soft  = target for a soft-delete run (DELETE_MODE=soft)
# ---------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=nps_chatbot_hard
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nps_chatbot_hard

# Optional: pristine copy of the DB, used by check_keep.py to detect chunks that
# KEEP targets had before the delete and lost afterwards (CHUNKS_LOST).
# Any BASELINE_PG_* value left blank falls back to the matching PG_* value.
BASELINE_PG_HOST=localhost
BASELINE_PG_PORT=5433
BASELINE_PG_USER=postgres
BASELINE_PG_PASSWORD=postgres
BASELINE_PG_DATABASE=nps_chatbot
# BASELINE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nps_chatbot

# ---------------------------------------------------------------------------
# Input workbook
# ---------------------------------------------------------------------------
XLSX_PATH=/home/saksham/Downloads/nps_script/NPS_RAG_Ingestion_Review_TRIAGED.xlsx
SHEET_URLS=DROP - URLs
SHEET_DOCS=DROP - Documents
# Sheets used by check_keep.py to verify KEEP targets are still in the DB
SHEET_URLS_KEEP=KEEP - URLs
SHEET_DOCS_KEEP=KEEP - Documents
# Column names as they appear in the header row of each sheet
COL_EXAMPLE_URL=Example full URL
COL_CANONICAL_URL=Canonical page (all locale/alias variants merged)
COL_FILE_NAME=File name
COL_SECTION=Section

# ---------------------------------------------------------------------------
# URL matching / normalization
# ---------------------------------------------------------------------------
# Also use the "Canonical page" column values (in addition to "Example full URL")
INCLUDE_CANONICAL_URLS=true
URL_LOWERCASE=true
URL_STRIP_WWW=true
URL_STRIP_TRAILING_SLASH=true
URL_STRIP_QUERY=true
URL_STRIP_FRAGMENT=true

# ---------------------------------------------------------------------------
# File-name matching (documents.document_name where source_type='DOCUMENT')
# strategy = exact | decoded | both
#   exact   : raw string comparison
#   decoded : compare after URL-decoding (%XX and '+' -> space)
#   both    : match if either raw or decoded matches
# ---------------------------------------------------------------------------
FILE_MATCH_STRATEGY=both
FILE_MATCH_CASE_SENSITIVE=false

# ---------------------------------------------------------------------------
# Deletion behaviour
# ---------------------------------------------------------------------------
# DELETE_MODE=hard | soft
#   hard : delete chunks matching DROP doc_name, then DELETE FROM documents
#   soft : set chunks.is_deleted=true, documents.status='TRASHED', deleted_at=now()
# In both modes chunks belonging to KEEP pages are reparented to surviving
# documents first and preserved (never removed via the document FK cascade).
DELETE_MODE=soft

# Safety: NEVER delete on the first run.
#   DRY_RUN=true  -> match + report only, no changes.
#   DRY_RUN=false -> still asks for final y/N confirmation on the console.
DRY_RUN=true
BATCH_SIZE=500

# Restrict deletion to specific document statuses (comma separated, empty = all)
# e.g. STATUS_FILTER=COMPLETED
STATUS_FILTER=
# Skip rows that are already soft-deleted (deleted_at IS NOT NULL)
SKIP_ALREADY_DELETED=true

# Also remove version chains that point at matched docs (supersedes/superseded_by)
INCLUDE_SUPERSEDES=true
# Also delete child rows (parent_document_id -> a matched doc) that would be orphaned
PURGE_ORPHAN_CHILDREN=false
# In soft mode, additionally set document_chunks.is_current=false
CHUNK_SET_IS_CURRENT=false

# ---------------------------------------------------------------------------
# Post-delete check
# ---------------------------------------------------------------------------
# Include rows that still exist but are soft-deleted (TRASHED) in the
# remaining-after-delete CSV. By default only "active" (retrievable) leftovers
# are written to the CSV.
INCLUDE_SOFT_DELETED_IN_LEFTOVERS=false

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
OUTPUT_DIR=./output
TIMESTAMPED_REPORTS=true
LOG_LEVEL=INFO