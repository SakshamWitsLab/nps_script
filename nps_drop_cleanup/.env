# Test configuration -> local Docker Postgres (copy of pristine nps_chatbot for hard-delete)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nps_chatbot_hard
# Pristine copy used by check_keep.py to detect lost KEEP chunks
BASELINE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nps_chatbot

XLSX_PATH=/home/saksham/Downloads/nps_script/NPS_RAG_Ingestion_Review_TRIAGED.xlsx

# soft delete by default; dry-run unless --apply is passed
DELETE_MODE=soft
DRY_RUN=true

# URL + file matching (defaults)
INCLUDE_CANONICAL_URLS=true
FILE_MATCH_STRATEGY=both

BATCH_SIZE=500
OUTPUT_DIR=./output
TIMESTAMPED_REPORTS=true
LOG_LEVEL=INFO
