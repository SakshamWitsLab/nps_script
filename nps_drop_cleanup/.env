# =============================================================================
# Local test configuration -> Docker Postgres on port 5433
#   nps_chatbot       : pristine reference (never modified) - used as baseline
#   nps_chatbot_hard  : result of a hard-delete run  (DELETE_MODE=hard)
#   nps_chatbot_soft  : result of a soft-delete run  (DELETE_MODE=soft)
#
# Connection is built from the PG_* variables (or a single DATABASE_URL).
# =============================================================================

# Target database
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=nps_chatbot_hard
# Alternatively, a single connection string (overrides PG_*):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nps_chatbot_hard

# Pristine copy used by check_keep.py to detect lost KEEP chunks (CHUNKS_LOST)
BASELINE_PG_HOST=localhost
BASELINE_PG_PORT=5433
BASELINE_PG_USER=postgres
BASELINE_PG_PASSWORD=postgres
BASELINE_PG_DATABASE=nps_chatbot
# Alternatively, a single connection string (overrides BASELINE_PG_*):
# BASELINE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nps_chatbot

XLSX_PATH=/home/saksham/Downloads/nps_script/NPS_RAG_Ingestion_Review_TRIAGED.xlsx

# hard = DELETE chunks by doc_name, then DELETE documents (this file targets the hard DB)
# soft = mark chunks is_deleted=true and documents TRASHED
DELETE_MODE=hard
# Safety: dry-run unless --apply is passed on the command line
DRY_RUN=true

# URL + file matching (defaults)
INCLUDE_CANONICAL_URLS=true
FILE_MATCH_STRATEGY=both

BATCH_SIZE=500
OUTPUT_DIR=./output
TIMESTAMPED_REPORTS=true
LOG_LEVEL=INFO
